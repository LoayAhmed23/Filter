[
  {
    "rule_id": "R001",
    "description": "Domestic transactions must have local country code",
    "condition": "'Liability_Indicator' == '003'",
    "assertion": "'Primary_Card_Number' is not None",
    "severity": "ERROR"
  },
  {
    "rule_id": "R002",
    "description": "Amount of installment required for all facilities except 002,003,004",
    "condition": "'Credit_Facility_Type' is not in ['002', '003', '004']",
    "assertion": "'Amount_of_Installment' is not None",
    "severity": "ERROR"
  },
  {
    "rule_id": "R003",
    "description": "Highest credit amount should be null for any other facility than 002,003,004",
    "condition": "'Credit_Facility_Type' is not in ['002', '003', '004']",
    "assertion": "'Highest_Credit' is None",
    "severity": "WARNING"
  },
  {
    "rule_id": "R004",
    "description": "Highest credit amount should not be null for facilities 002,003,004",
    "condition": "'Credit_Facility_Type' is in ['002', '003', '004']",
    "assertion": "'Highest_Credit' is not None",
    "severity": "WARNING"
  },
  {
    "rule_id": "R005",
    "description": "For facilities other than revolving facilities (002,003,004) the term of loan is required",
    "condition": "'Credit_Facility_Type' is not in ['002', '003', '004']",
    "assertion": "'Term_of_Loan' is not None",
    "severity": "ERROR"
  },
  {
    "rule_id": "R006",
    "description": "If Number of days past due is greater than 0 then Amount Overdue can't be zero",
    "condition": "'Number_of_Days_Past_Due' > 0",
    "assertion": "'Amount_Overdue' > 0",
    "severity": "ERROR"
  },
  {
    "rule_id": "R007",
    "description": "Credit facility type should be valid according to the credit_facility_types catalog",
    "condition": "'Credit Facility Type' is not None",
    "assertion": "'Credit Facility Type' in credit_facility_types",
    "severity": "ERROR"
  }
]
