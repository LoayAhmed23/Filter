{
  "name": "Credit Facilty",
  "description": "Regulatory Report A — sample schema (customize to your needs)",
  "sheet_name": "Sheet1",
  "header_row": 1,
  "data_start_row": 2,

  "fields": [
    {
      "name": "1. Segment Identifier",
      "column": "Segment Identifier",
      "data_type": "string",
      "category": "required",
      "catalog": "currency_codes",
      "max_length": 4,
      "min_length": 4,
      "description": "Must contain the Value CNCF"
    },
    {
      "name": "2. Data Provider ID",
      "column": "Data Provider ID",
      "data_type": "string",
      "category": "required",
      "max_length": 10,
      "min_length": 10,
      "description": "Unique identifier for the data provider"
    },
    {
      "name": "3. Previous Data Provider ID",
      "column": "Previous Data Provider ID",
      "data_type": "string",
      "category": "optional",
      "max_length": 10,
      "min_length": 10,
      "description": "Unique identifier for the previous data provider"
    },
    {
      "name": "4. Data Provider Branch ID",
      "column": "Data Provider Branch ID",
      "data_type": "string",
      "category": "required",
      "max_length": 4,
      "min_length": 4,
      "description": "Conatain internal branch code of the data provider"
    },
    {
      "name": "5. Previous Data Provider Branch ID",
      "column": "Previous Data Provider Branch ID",
      "data_type": "string",
      "category": "optional",
      "max_length": 4,
      "min_length": 4,
      "description": "Internal branch code of the previous data provider"
    },
    {
      "name": "6. Credit Facility Account Number",
      "column": "Credit Facility Account Number",
      "data_type": "string",
      "category": "required",
      "min_length": 25,
      "max_length": 25,
      "description": "Credit Facility Account Number/Card Number assigned by the Data Provider"
    },
    {
      "name": "7. Consent Status",
      "column": "Consent Status",
      "data_type": "string",
      "category": "required",
      "catalog": "consent_statuses",
      "max_length": 3,
      "min_length": 3,
      "description": "Must contain the status of the consent as provided by the Subject to the Data provider"
    },
    {
      "name": "8. Consent Expiry Date",
      "column": "Consent Expiry Date",
      "data_type": "date",
      "category": "required",
      "catalog": "country_codes",
      "max_length": 2,
      "min_length": 2,
      "description": "ISO 3166-1 alpha-2 country code"
    },

    {
      "name": "remarks",
      "column": "Remarks",
      "data_type": "string",
      "category": "optional",
      "max_length": 500,
      "description": "Free-text remarks"
    },
    {
      "name": "reference_number",
      "column": "Reference No.",
      "data_type": "string",
      "category": "optional",
      "pattern": "^REF-[0-9]{6,10}$",
      "description": "Optional reference in format REF-NNNNNN"
    },

    {
      "name": "agent_code",
      "column": "Agent Code",
      "data_type": "string",
      "category": "group:agent_info",
      "catalog": "agent_codes",
      "description": "Agent identifier (part of agent_info group)"
    },
    {
      "name": "agent_name",
      "column": "Agent Name",
      "data_type": "string",
      "category": "group:agent_info",
      "max_length": 100,
      "description": "Agent full name (part of agent_info group)"
    },
    {
      "name": "agent_branch",
      "column": "Agent Branch",
      "data_type": "string",
      "category": "group:agent_info",
      "catalog": "branch_codes",
      "description": "Agent branch code (part of agent_info group)"
    }
  ]
}
